{
  "name": "cuaderno",
  "productName": "Cuaderno",
  "version": "1.1.4",
  "description": "Cuaderno del Máster en Profesor/a de Educación Secundaria (UV)",
  "author": "Cuaderno UV",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "mac": "electron-builder --mac",
    "win": "electron-builder --win"
  },
  "dependencies": {
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "26.17.0",
    "@huggingface/transformers": "4.3.1",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "es.uv.cuaderno",
    "productName": "Cuaderno",
    "copyright": "Cuaderno UV",
    "files": [
      "main.js",
      "package.json",
      "web/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "artifactName": "Cuaderno-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "janocrv",
        "repo": "cuaderno"
      }
    ],
    "mac": {
      "icon": "recursos/icono.icns",
      "category": "public.app-category.education",
      "minimumSystemVersion": "12.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSHumanReadableCopyright": "Cuaderno UV"
      }
    },
    "dmg": {
      "title": "Cuaderno",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "recursos/icono.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cuaderno",
      "deleteAppDataOnUninstall": false
    }
  },
  "cuadernoRepo": "janocrv/cuaderno"
}
